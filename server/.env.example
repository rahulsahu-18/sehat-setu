PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sehatsetu_demo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
DATA_RETENTION_DAYS=90
# LiveKit voice follow-up (optional locally; text follow-up works without it)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=sehatsetu-followup-agent
VOICE_AGENT_SECRET=replace-with-a-long-random-private-secret
VOICE_AGENT_API_BASE_URL=http://localhost:5000

# Clinical safety sign-off (required for production startup; do not mark approved until a qualified clinician signs off)
CLINICAL_SAFETY_POLICY_STATUS=unreviewed
CLINICAL_SAFETY_POLICY_APPROVED_BY=
CLINICAL_SAFETY_POLICY_APPROVED_AT=
CLINICAL_SAFETY_POLICY_REVIEW_RECORD=
